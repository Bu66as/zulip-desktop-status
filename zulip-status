KONFIG = os.path.expanduser("~/.config/zulip-status/config.env")


def einstellungen():
    """KEY=value aus KONFIG; gleichnamige Umgebungsvariablen gewinnen."""
    werte = {}
    try:
        with open(KONFIG) as fh:
            for zeile in fh:
                zeile = zeile.strip()
                if zeile and not zeile.startswith("#") and "=" in zeile:
                    name, wert = zeile.split("=", 1)
                    werte[name.strip()] = wert.strip().strip('"')
    except OSError:
        pass
    werte.update({k: v for k, v in os.environ.items() if k.startswith("ZULIP_STATUS_")})
    return werte


def sprache(cfg):
    wahl = cfg.get("ZULIP_STATUS_LANG") or next(
        (os.environ[k] for k in ("LC_ALL", "LC_MESSAGES", "LANG") if os.environ.get(k)), "")
    return "de" if wahl.lower().startswith("de") else "en"


