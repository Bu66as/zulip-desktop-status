# ~/.config/zulip-status/config.env
# Language of status texts and messages: de or en (default: from the locale)
#ZULIP_STATUS_LANG=en

# Work hours, Monday to Friday. Outside of them: invisible and "Off work".
ZULIP_STATUS_VON=08:00
ZULIP_STATUS_BIS=16:30

# Home networks (CIDR, space separated). Inside: "Working from home",
# elsewhere: "On the road". Empty = always at home.
ZULIP_STATUS_HEIMNETZE=

# Minutes of screen lock until presence goes invisible and the status "Away".
ZULIP_STATUS_UNSICHTBAR_MIN=5

# An all-day calendar event with this word in the title counts as vacation
# (default: "vacation", with ZULIP_STATUS_LANG=de "urlaub").
#ZULIP_STATUS_URLAUB_WORT=vacation
